{
  "schemaVersion": 1,
  "id": "splineroads",
  "version": "2.1.0+fabric",
  "name": "Spline Roads (Unofficial Fabric Port)",
  "description": "UNOFFICIAL, non-commercial Fabric port of Spline Roads 2.1.0 (Forge 1.20.1) by ShiraAya. Endpoint-based solid spline roads, junctions, ramps, interchanges, bridges, tunnels, signs and signals. Not affiliated with or endorsed by the original author.",
  "authors": [
    "ShiraAya (original Forge mod)",
    "Unofficial Fabric port"
  ],
  "license": "Spline Roads Non-Commercial License (see META-INF/LICENSE.txt)",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.sora.splineroads.fabric.SplineRoadsFabric"
    ],
    "client": [
      "com.sora.splineroads.fabric.SplineRoadsFabricClient"
    ]
  },
  "mixins": [
    {
      "config": "splineroads.mixins.json",
      "environment": "*"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  },
  "custom": {
    "splineroads:port": {
      "unofficial": true,
      "upstream": "https://github.com/ShiraAya/Spline-Roads-Release",
      "upstream_version": "2.1.0",
      "upstream_loader": "forge"
    }
  },
  "suggests": {
    "mtr": ">=4.0.5"
  }
}
